// Memory.hdl - RAM16K (0-16383), Screen (16384-24575), Keyboard (24576)
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14]=0 -> RAM; address[14]=1 -> Screen/Keyboard region
    DMux(in=load, sel=address[14], a=loadRam, b=loadHigh);
    // Inside the high region, address[13]=0 -> Screen, =1 -> Keyboard (read-only)
    Not(in=address[13], out=notA13);
    And(a=loadHigh, b=notA13, out=loadScreen);   // gate so a write to KBD can't hit SCREEN[0]

    RAM16K(in=in, load=loadRam,    address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux16(a=screenOut, b=kbdOut, sel=address[13], out=highOut);
    Mux16(a=ramOut,    b=highOut, sel=address[14], out=out);
}
